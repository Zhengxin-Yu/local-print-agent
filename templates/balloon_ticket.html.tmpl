<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>气球小票 {{.JobID}}</title>
<style>
@page { size: 80mm 120mm; margin: 4mm; }
* { box-sizing: border-box; }
body { margin: 0; color: #111; font-family: "Microsoft YaHei", "Noto Sans CJK SC", sans-serif; }
.ticket { min-height: 112mm; border: 1px solid #111; padding: 5mm; }
h1 { margin: 0 0 4mm; font-size: 18pt; }
dl { margin: 0; font-size: 12pt; }
dt { margin-top: 2mm; color: #444; }
dd { margin: 0; font-weight: 700; overflow-wrap: anywhere; }
.color { display: inline-block; padding: 1mm 2mm; border: 1px solid #111; }
</style>
</head>
<body>
<main class="ticket">
<h1>气球小票</h1>
<dl>
  <dt>比赛</dt><dd>{{.ContestName}}</dd>
  <dt>队伍编号</dt><dd>{{.TeamID}}</dd>
  <dt>队伍</dt><dd>{{.TeamName}}</dd>
  <dt>题目</dt><dd>{{.ProblemID}}</dd>
  <dt>房间</dt><dd>{{.Room}}</dd>
  <dt>气球颜色</dt><dd><span class="color">{{.BalloonColor}}</span></dd>
  <dt>通过时间</dt><dd>{{.SolvedAt}}</dd>
  <dt>任务编号</dt><dd>{{.JobID}}</dd>
</dl>
</main>
</body>
</html>
